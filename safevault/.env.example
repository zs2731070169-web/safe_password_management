# ============ SafeVault 后端环境变量示例 ============
# 复制为 .env 后按需修改：cp .env.example .env

# ---------- MySQL（主库：云账户/认证、加密备份 blob、恢复凭据）----------
# 异步驱动 asyncmy，与 FastAPI async 链路一致
DATABASE_URL=mysql+asyncmy://safevault:safevault@localhost:3306/safevault
# SQL 回显（排查时置 true 打印执行的 SQL）
DB_ECHO=false
# 连接池：常驻连接数 / 峰值临时溢出 / 池满获取等待秒数 / 连接最长存活秒数
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ---------- Redis ----------
# 验证码、发码冷却、限流计数都存这里
REDIS_URL=redis://localhost:6379/0

# ---------- RabbitMQ ----------
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# 发码邮件任务队列名
MAIL_QUEUE=mail.verify_code

# ---------- Brevo 邮件发送（HTTP API，注册免信用卡，无需域名即可起步）----------
# 1) 注册 brevo.com（邮箱即可，免信用卡）
# 2) 后台 SMTP & API → API Keys 生成 v3 API Key，填到 BREVO_API_KEY
# 3) Senders, Domains & Dedicated IPs → Senders 验证一个发件邮箱，填到 BREVO_SENDER_EMAIL
BREVO_API_KEY=your-brevo-v3-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=SafeVault
# 发信代理：本机联调访问境外 api.brevo.com 走本地代理（Clash/V2Ray 混合端口用 http 即可，无需 socksio）。
# 直连环境（如境外服务器）留空。发信不再读取系统 ALL_PROXY/HTTPS_PROXY，仅认此项。
MAIL_PROXY=http://127.0.0.1:7890

# ---------- 验证码策略 ----------
# 验证码有效期（秒），对齐时序图 TTL 300s
CODE_TTL=300
# 同一邮箱发码冷却（秒），对齐时序图 60s
COOLDOWN_TTL=60

# ---------- 限流（替代 API 网关，应用内 Redis 滑动窗口）----------
# 滑动窗口长度（秒）
RATE_LIMIT_WINDOW=60
# 单邮箱每窗口最大发码次数
RATE_LIMIT_EMAIL_PER_WINDOW=5
# 单 IP 每窗口最大发码次数
RATE_LIMIT_IP_PER_WINDOW=20

# ---------- JWT（Token 服务，§2 注册即登录签发 access/refresh）----------
# ⚠️ 生产必须覆盖为高熵随机串（如 openssl rand -hex 32），切勿沿用此开发默认值
JWT_SECRET=dev-only-insecure-change-me-in-production
JWT_ALGORITHM=HS256
# access 短时效（分钟）/ refresh 长时效（天），对齐时序图 access(15min) + refresh(30d)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# 落库前对客户端 verifier 叠加 server_salt 的服务端慢哈希迭代次数（PBKDF2-HMAC-SHA256）
VERIFIER_HASH_ITERATIONS=200000
# 注册接口单 IP 每窗口最大尝试次数
REGISTER_RATE_LIMIT_IP_PER_WINDOW=10
# 忘记密码重置接口（§6）单 IP 每窗口最大尝试次数（须先收到真验证码才走得通，阈值收紧防滥用）
RESET_RATE_LIMIT_IP_PER_WINDOW=10

# ---------- S3 兼容对象存储（模块 2：加密备份 blob 存储，PUT /backup）----------
# 整库 AES-GCM 密文本体存 S3 兼容对象存储（对象 key = `{OSS_KEY_PREFIX}/{userId}`，覆盖写），
# 后端对密文完全不透明、永不解析。以下四项任一为空即视为「未配置」：应用照常启动（仅告警），
# 但备份上传不可用。变量沿用 OSS_ 前缀仅为兼容，语义已是通用对象存储，与阿里云无关。
# S3 端点 URL（须带 scheme；MinIO 形如 http://127.0.0.1:9000）
OSS_ENDPOINT=http://127.0.0.1:9000
# 区域名（boto3 必填；MinIO 可任意值，R2 填 auto，AWS S3 填真实区域）
OSS_REGION=us-east-1
# Bucket 名称（需提前在 MinIO 控制台 / mc 建好）
OSS_BUCKET=safevault
# 访问密钥 ID（MinIO 的 root user 或独立 access key）
OSS_ACCESS_KEY_ID=minioadmin
# 访问密钥 Secret（敏感，切勿提交真实值；生产请改用强随机密钥）
OSS_ACCESS_KEY_SECRET=minioadmin
# 对象 key 前缀，最终 key = `{prefix}/{userId}`
OSS_KEY_PREFIX=backup

# ---------- 加密备份体积上限（模块 2）----------
# 上传备份的密文体积上限（字节，对 ciphertext base64 解码后的原始长度判定），默认 5 MiB；
# 超限返回 413「备份体积超限」。按业务整库规模可上调（注意同步评估对象存储 / 磁盘容量）。
BACKUP_MAX_SIZE_BYTES=5242880
