{
  "name": "safevault-app",
  "version": "1.0.0",
  "private": true,
  "description": "SafeVault 密码安全助手 · uni-app 工程（App(Android/iOS) + H5）",
  "scripts": {
    "dev:h5": "cross-env UNI_INPUT_DIR=. UNI_OUTPUT_DIR=unpackage/dist/dev/h5 uni",
    "dev:app": "cross-env UNI_INPUT_DIR=. UNI_OUTPUT_DIR=unpackage/dist/dev/app-plus uni -p app",
    "build:h5": "cross-env UNI_INPUT_DIR=. UNI_OUTPUT_DIR=unpackage/dist/build/h5 uni build",
    "build:app": "cross-env UNI_INPUT_DIR=. UNI_OUTPUT_DIR=unpackage/dist/build/app-plus uni build -p app",
    "type-check": "cross-env UNI_INPUT_DIR=. UNI_OUTPUT_DIR=unpackage/dist/build/h5 uni build --minify false",
    "test:crypto": "node scripts/crypto-parity-test.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5000720260410001",
    "@dcloudio/uni-app-plus": "3.0.0-5000720260410001",
    "@dcloudio/uni-components": "3.0.0-5000720260410001",
    "@dcloudio/uni-h5": "3.0.0-5000720260410001",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "pinia": "^2.2.2",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-5000720260410001",
    "@dcloudio/uni-cli-shared": "3.0.0-5000720260410001",
    "@dcloudio/uni-stacktracey": "3.0.0-5000720260410001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5000720260410001",
    "@vue/runtime-core": "^3.4.21",
    "cross-env": "^7.0.3",
    "sass": "^1.77.8",
    "vite": "5.2.8"
  }
}
